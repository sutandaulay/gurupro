model payload_kv {
  id   Int    @id @default(autoincrement())
  key  String @db.VarChar
  data Json
}

model payload_locked_documents {
  id                            Int                             @id @default(autoincrement())
  global_slug                   String?                         @db.VarChar
  updated_at                    DateTime                        @default(now()) @db.Timestamptz(3)
  created_at                    DateTime                        @default(now()) @db.Timestamptz(3)
  payload_locked_documents_rels payload_locked_documents_rels[]
}

model payload_locked_documents_rels {
  id                       Int                      @id @default(autoincrement())
  order                    Int?
  parent_id                Int
  path                     String                   @db.VarChar
  cms_users_id             Int?
  media_id                 Int?
  cms_features_id          String?                  @db.Uuid
  why_points_id            String?                  @db.Uuid
  categories_id            Int?
  posts_id                 Int?
  addon_token_packages_id  String?                  @db.Uuid
  institutions_id          Int?
  institution_members_id   Int?
  addon_token_packages     addon_token_packages?    @relation(fields: [addon_token_packages_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "payload_locked_documents_rels_addon_token_packages_fk")
  categories               categories?              @relation(fields: [categories_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "payload_locked_documents_rels_categories_fk")
  cms_features             cms_features?            @relation(fields: [cms_features_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "payload_locked_documents_rels_cms_features_fk")
  cms_users                cms_users?               @relation(fields: [cms_users_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "payload_locked_documents_rels_cms_users_fk")
  institution_members      institution_members?     @relation(fields: [institution_members_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "payload_locked_documents_rels_institution_members_fk")
  institutions             institutions?            @relation(fields: [institutions_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "payload_locked_documents_rels_institutions_fk")
  media                    media?                   @relation(fields: [media_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "payload_locked_documents_rels_media_fk")
  payload_locked_documents payload_locked_documents @relation(fields: [parent_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "payload_locked_documents_rels_parent_fk")
  posts                    posts?                   @relation(fields: [posts_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "payload_locked_documents_rels_posts_fk")
  why_points               why_points?              @relation(fields: [why_points_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "payload_locked_documents_rels_why_points_fk")
}

model payload_migrations {
  id         Int      @id @default(autoincrement())
  name       String?  @db.VarChar
  batch      Decimal? @db.Decimal
  updated_at DateTime @default(now()) @db.Timestamptz(3)
  created_at DateTime @default(now()) @db.Timestamptz(3)
}

model payload_preferences {
  id                       Int                        @id @default(autoincrement())
  key                      String?                    @db.VarChar
  value                    Json?
  updated_at               DateTime                   @default(now()) @db.Timestamptz(3)
  created_at               DateTime                   @default(now()) @db.Timestamptz(3)
  payload_preferences_rels payload_preferences_rels[]
}

model payload_preferences_rels {
  id                  Int                 @id @default(autoincrement())
  order               Int?
  parent_id           Int
  path                String              @db.VarChar
  cms_users_id        Int?
  cms_users           cms_users?          @relation(fields: [cms_users_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "payload_preferences_rels_cms_users_fk")
  payload_preferences payload_preferences @relation(fields: [parent_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "payload_preferences_rels_parent_fk")
}

model posts {
  id                            Int                             @id @default(autoincrement())
  title                         String                          @db.VarChar(255)
  slug                          String?                         @unique @db.VarChar(255)
  excerpt                       String?
  content                       String?
  featured_image                String?
  author                        String?                         @default("Admin") @db.VarChar(255)
  status                        String?                         @default("draft") @db.VarChar(20)
  category_id                   Int?
  tags                          String[]
  view_count                    Int?                            @default(0)
  published_at                  DateTime?                       @db.Timestamp(6)
  created_at                    DateTime?                       @default(now()) @db.Timestamp(6)
  updated_at                    DateTime?                       @default(now()) @db.Timestamp(6)
  published_date                DateTime?                       @db.Timestamptz(3)
  featured_image_id             Int?
  status_cms                    enum_posts_status?              @default(draft) @map("_status")
  posts_v                       posts_v[]
  payload_locked_documents_rels payload_locked_documents_rels[]
  categories                    categories?                     @relation(fields: [category_id], references: [id], onUpdate: NoAction, map: "posts_category_id_categories_id_fk")
  media                         media?                          @relation(fields: [featured_image_id], references: [id], onUpdate: NoAction, map: "posts_featured_image_id_media_id_fk")
}

model why_points {
  id                            String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  point                         String                          @db.VarChar(500)
  order                         Int?                            @default(0)
  isActive                      Boolean?                        @default(true)
  created_at                    DateTime?                       @default(now()) @db.Timestamp(6)
  updated_at                    DateTime?                       @default(now()) @db.Timestamp(6)
  is_active                     Boolean?                        @default(true)
  payload_locked_documents_rels payload_locked_documents_rels[]
}

