model school_registrations {
  id                String   @id @default(uuid()) @db.Uuid
  nama_lembaga      String   @db.VarChar(255)
  npsn              String?  @db.VarChar(50)
  jenjang           String   @db.VarChar(50)
  naungan           String   @db.VarChar(50)
  alamat            String?  @db.Text
  nama_kepala_sekolah String? @db.VarChar(255)
  email_kontak      String   @db.VarChar(255)
  whatsapp          String?  @db.VarChar(20)
  status            String   @default("pending") @db.VarChar(20)
  catatan_admin     String?  @db.Text
  created_at        DateTime @default(now()) @db.Timestamptz(3)
  updated_at        DateTime @updatedAt @db.Timestamptz(3)
}

