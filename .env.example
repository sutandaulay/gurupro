# ==============================================
# GuruPRO Environment Variables
# Copy file ini ke .env.local dan isi nilainya
#
# Keterangan:
#  - "WAJIB"  = tanpa nilai ini fitur/path terkait gagal jalan di production
#  - "Opsional" = hanya dipakai fitur tertentu; boleh kosong
#  - Provider AI (OpenAI / DeepSeek / Claude), SMTP, dan Fonnte TIDAK dibaca
#    dari env — kredensialnya disimpan di Admin Panel (system_settings).
# ==============================================

# ─── App URLs ───
NEXT_PUBLIC_APP_URL=https://your-domain.com  # URL production (WAJIB di-set saat deploy)
APP_URL=https://your-domain.com              # fallback server-side untuk cron/email
NEXT_PUBLIC_BASE_URL=https://your-domain.com  # link approval registrasi sekolah
NEXT_PUBLIC_SITE_URL=https://your-domain.com  # sitemap + robots.txt
NEXT_PUBLIC_APP_NAME=GuruPRO

# ─── Database (PostgreSQL) ───
DB_USER=postgres
DB_HOST=localhost
DB_NAME=gurupro_db
DB_PASSWORD=
DB_PORT=5432
DATABASE_URL=postgresql://postgres:password@localhost:5432/gurupro_db

# ─── NextAuth ───
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here-generate-with-openssl

# ─── Payload CMS ───
PAYLOAD_SECRET=your-payload-secret-change-in-production
PAYLOAD_CONFIG_PATH=payload.config.ts

# ─── Google OAuth (Opsional) ───
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Payment Gateway ───
# Midtrans — server key dipakai untuk verifikasi signature webhook (SHA512)
MIDTRANS_SERVER_KEY=
# Xendit — token untuk verifikasi signature webhook
XENDIT_WEBHOOK_TOKEN=
# Default gateway saat checkout: midtrans | xendit | mock
# Disimpan di Admin Panel (system_settings), bukan env.
# "mock" hanya boleh di development/staging — production otomatis menolak (503)

# ─── AI Provider (Opsional) ───
# Kunci provider lain (OpenAI / DeepSeek / Claude) diatur lewat Admin Panel.
GEMINI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_AI_API_KEY=

# ─── Storage — Cloudflare R2 (Opsional, tapi wajib untuk upload file) ───
# without these, upload file dinonaktifkan (lib/r2.ts)
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_PUBLIC_URL=https://<bucket>.<subdomain>.r2.dev

# R2 bucket terpisah untuk perpustakaan digital (lib/r2-library.ts)
R2_LIBRARY_ACCESS_KEY_ID=
R2_LIBRARY_SECRET_ACCESS_KEY=
R2_LIBRARY_ENDPOINT=
R2_LIBRARY_BUCKET=

# R2 bucket cadangan untuk backup (scripts/backup/r2-backup.ts)
R2_SECONDARY_BUCKET_NAME=
R2_SECONDARY_ENDPOINT=

# ─── Session & Auth ───
# Session signing key (HMAC-SHA256) — generate with: openssl rand -hex 32
SESSION_SECRET=
# Set ke "false" hanya di dev lewat HTTP; production selalu secure
SESSION_COOKIE_SECURE=
# Shared secret untuk endpoint admin/ai-monitoring
ADMIN_SECRET=

# ─── Cron ───
CRON_SECRET=gurupro-cron-secret-dev-change-in-production
# Alias lama — dipakai sebagai fallback oleh /api/cron/token-jobs
CRON_SECRET_TOKEN=

# ─── Voice Briefing (Web Push / VAPID) ───
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@gurupro.id

# ─── CORS ───
# comma-separated list of allowed browser origins
# Defaults to https://gurupro.id,https://www.gurupro.id if not set
ALLOWED_ORIGINS=

# ─── Webhook IP allowlist ───
# comma-separated IPs of trusted payment providers
# Example: 1.2.3.4,5.6.7.8 (leave empty to disable IP-based webhook verification)
WEBHOOK_ALLOWED_IPS=

# ─── Transactional Email (Opsional) ───
# Alternatif dari SMTP config di Admin Panel
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# ─── Sentry Error Tracking (Opsional) ───
# DSN can be obtained from https://sentry.io → Project Settings → Client Keys
# Server-side DSN (never exposed to browser)
SENTRY_DSN=
# Client-side DSN (exposed to browser, OK to expose)
NEXT_PUBLIC_SENTRY_DSN=
# Token upload source map (opsional)
SENTRY_AUTH_TOKEN=
LOG_LEVEL=info

# ─── Analytics (Opsional) ───
# Endpoint custom untuk menerima eventusage AI
AI_ANALYTICS_URL=
