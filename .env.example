# ==============================================
# GuruPRO Environment Variables
# Copy file ini ke .env.local dan isi nilainya
# ==============================================

# App URLs
NEXT_PUBLIC_APP_URL=https://your-domain.com  # URL production (WAJIB di-set saat deploy)
NEXT_PUBLIC_APP_NAME=GuruPRO

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/gurupro

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here-generate-with-openssl

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Payment Gateway - Xendit
XENDIT_API_KEY=
XENDIT_WEBHOOK_TOKEN=

# Payment Gateway - Midtrans
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_MERCHANT_ID=

# AI/LLM Providers
GEMINI_API_KEY=
OPENAI_API_KEY=
CLAUDE_API_KEY=
DEEPSEEK_API_KEY=

# WhatsApp Gateway (Optional)
FONNTE_API_TOKEN=

# Email SMTP (Optional)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=

# Voice Briefing Guru (VAPID untuk Web Push)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@gurupro.id

# Cron
CRON_SECRET=gurupro-cron-secret-dev-change-in-production

# Session signing key (HMAC-SHA256) — generate with: openssl rand -hex 32
SESSION_SECRET=

# Sentry Error Tracking (optional)
# DSN can be obtained from https://sentry.io → Project Settings → Client Keys
SENTRY_DSN=
LOG_LEVEL=info
