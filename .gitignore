# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next_old/
/out/
/.next_*/

# production
/build

# agent tool worktrees (never part of the app)
.kilo/
.worktrees/
.agents/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# log files
*.log

# uploads
/public/uploads/

# Auto-generated by Payload CMS
payload-types.ts

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

nul

# scratch / temp debug scripts
scratch/

# local artifacts from tooling / manual debugging
cookies.txt
playwright-results.json
playwright-report/
playwright-traces/
test-results/
build.log
dev-server.log

# Claude Code local settings (may contain machine-specific credentials)
.claude/settings.json
